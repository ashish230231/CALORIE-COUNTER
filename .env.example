# Copy to .env to customise. Every value has a sensible default, so this file is optional.

# Port the app is served on: http://localhost:8080
APP_PORT=8080

# Database credentials (the database is only reachable inside the Docker network).
POSTGRES_DB=calorie
POSTGRES_USER=calorie
POSTGRES_PASSWORD=calorie

# Import the USDA FoodData Central databases automatically on first start.
USDA_AUTO_IMPORT=true

# Look up packaged products by barcode on Open Food Facts (sends only the barcode).
OPENFOODFACTS_ENABLED=true

# Automatic database backups written to ./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
